# --- Secrets ---
.env
.env.local
.env.*.local

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/
.mypy_cache/

# --- Node / Next.js ---
node_modules/
.next/
out/
*.tsbuildinfo
.turbo/

# --- Data (source PDFs + derived artefacts) ---
# The corpus itself is public BRH material; we keep raw PDFs local so
# the repo stays light. `data/processed/` is fully derived and ignored.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/web/

# --- LangGraph / LangSmith local state ---
.langgraph_api/
.langgraph_data/
langgraph_api/
logs/

# --- Experiments (notebooks) ---
*.ipynb_checkpoints/
experiments/.venv/
experiments/artifacts/*
!experiments/artifacts/.gitkeep

# --- Analytics output (regenerate with `make analytics`) ---
services/analytics/out/

# --- OS / editor ---
.DS_Store
*.swp
