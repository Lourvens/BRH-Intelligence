# =====================================================================
# BRH Intelligence — environment template
# Copy to `.env` (gitignored) and fill in. Never commit real secrets.
# Read by packages/core, services/agent and services/mcp.
# The web app uses apps/web/.env.local instead (NEXT_PUBLIC_*).
# =====================================================================

# --- Data paths -------------------------------------------------------
# Relative paths resolve against BRH_DATA_ROOT, otherwise the repo root.
# BRH_DATA_ROOT=/absolute/path/to/brh-intelligence
BRH_OCR_DIR=./data/ocr
BRH_PUBLICATION_DIR=./data/published
# local for development; s3 for durable shared deployment storage.
BRH_ARTIFACT_BACKEND=local
# BRH_ARTIFACT_S3_BUCKET=brh-publications
# BRH_ARTIFACT_S3_ENDPOINT=https://your-s3-compatible-endpoint
# BRH_ARTIFACT_S3_REGION=us-east-1
# S3 credentials use the standard AWS SDK chain (roles or AWS_* variables).
BRH_RAW_DIR=./data/raw
BRH_PROCESSED_DIR=./data/processed

# --- PostgreSQL — corpus system of record (ADR-0003) ------------------
BRH_POSTGRES_HOST=localhost
BRH_POSTGRES_PORT=5432
BRH_POSTGRES_DB=brh_corpus
BRH_POSTGRES_USER=brh
BRH_POSTGRES_PASSWORD=brh
BRH_POSTGRES_SCHEMA=corpus

# --- Pinecone — vector store (ADR-0003) -------------------------------
# The index is provisioned out-of-band. Runtime only connects.
# Vector backend: pinecone_integrated | pinecone | memory
BRH_VECTOR_BACKEND=pinecone
BRH_PINECONE_API_KEY=
BRH_PINECONE_INDEX_NAME=brh-intelligence-qwen-1024
BRH_PINECONE_NAMESPACE=default

# --- Embeddings (ADR-0004) --------------------------------------------
# BRH_EMBEDDING_PROVIDER selects how chunk text becomes vectors:
#   pinecone   -> Pinecone integrated inference embeds server-side
#   openrouter -> Qwen embeddings via LangChain (embedding-only key)
#   openai     -> client-side OpenAI-compatible embeddings (optional block below)
#   hashing    -> deterministic offline embeddings, tests/dev only
BRH_EMBEDDING_PROVIDER=openrouter
BRH_EMBEDDING_MODEL=qwen/qwen3-embedding-8b
BRH_EMBEDDING_DIM=1024
OPENROUTER_EMBEDDING_API_KEY=
BRH_EMBEDDING_TOKENIZER=Qwen/Qwen3-Embedding-8B
BRH_EMBEDDING_TOKENIZER_REVISION=1d8ad4ca9b3dd8059ad90a75d4983776a23d44af
BRH_EMBEDDING_CONTEXT_LIMIT=32768
BRH_EMBEDDING_BATCH_SIZE=32
BRH_EMBEDDING_BATCH_TOKENS=16384
BRH_EMBEDDING_CONCURRENCY=2
BRH_EMBEDDING_REQUESTS_PER_SECOND=1
# Optional client-side OpenAI-compatible embeddings (BRH_EMBEDDING_PROVIDER=openai).
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# --- Ingestion and chunking (ADR-0011) --------------------------------
BRH_INGESTION_WORKERS=4
BRH_CHUNK_TARGET_TOKENS=768
BRH_CHUNK_MAX_TOKENS=1536

# --- Retrieval --------------------------------------------------------
BRH_RETRIEVAL_TOP_K=6

# --- Agent models — OpenRouter ----------------------------------------
# Chat and decision share OPENROUTER_API_KEY. Embeddings use the key above.
OPENROUTER_API_KEY=
# Chat role
BRH_CHAT_PROVIDER=openrouter
BRH_CHAT_BASE_URL=https://openrouter.ai/api/v1
BRH_CHAT_MODEL=mistralai/ministral-8b-2512
BRH_CHAT_TEMPERATURE=0
BRH_CHAT_MAX_TOKENS=2048
BRH_CHAT_TIMEOUT=60
BRH_CHAT_MAX_RETRIES=2
# Small-model role — thread titles and lightweight tasks
BRH_SLM_BASE_URL=https://openrouter.ai/api/v1
BRH_SLM_MODEL=mistralai/ministral-8b-2512
BRH_SLM_TIMEOUT=20
BRH_SLM_MAX_TOKENS=128
# Decision role — endpoint = BASE_URL + API_PATH, not /chat/completions
BRH_DECISION_PROVIDER=openrouter
BRH_DECISION_BASE_URL=https://openrouter.ai/api
BRH_DECISION_API_PATH=/alpha/decisions
BRH_DECISION_MODEL=typesafe/jev-1.14
BRH_DECISION_TIMEOUT=60

# --- Citations --------------------------------------------------------
# The web app serves PDFs via /api/pdfs; deep links append #page=N.
BRH_PUBLIC_PDF_BASE_URL=http://localhost:3000/api/pdfs

# --- Observability — LangSmith tracing --------------------------------
# LangChain/LangGraph export traces automatically when these are set.
LANGSMITH_TRACING=true
# Required for hosted tracing: add your LangSmith API key.
LANGSMITH_API_KEY=
# Agent-based workspace: traces address the agent and environment.
LANGSMITH_AGENT_ID=brh-intelligence
LANGSMITH_AGENT_ENVIRONMENT=local
# --- Web inventory (discovery of brh.ht) ------------------------------
BRH_WEB_BASE_URL=https://www.brh.ht
BRH_WEB_USER_AGENT=brh-intelligence-inventory/0.1 (+public-sector document inventory)
BRH_WEB_REQUEST_DELAY=0.3
BRH_WEB_TIMEOUT=30
BRH_WEB_MAX_RETRIES=3

# --- Experiments — LlamaParse reference set ---------------------------
# Only the standalone experiments project reads this key.
# LLAMA_CLOUD_API_KEY=
