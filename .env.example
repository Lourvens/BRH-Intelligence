# =====================================================================
# BRH Intelligence — environment template
# Copy to `.env` (gitignored) and fill in. Never commit real secrets.
# Shared by: packages/core, services/agent, services/mcp.
# =====================================================================

# --- Runtime -----------------------------------------------------------
BRH_ENV=development
BRH_LOG_FORMAT=plain            # plain | json

# --- Data paths (relative to repo root) -------------------------------
# Raw discovery target for the autodiscovery + ingestion pipeline.
BRH_RAW_DIR=./data/raw
BRH_PROCESSED_DIR=./data/processed

# --- LLM (provider-agnostic; swap without code changes) ---------------
# LLM_PROVIDER selects the chat model backend: anthropic | openai
BRH_LLM_PROVIDER=anthropic
BRH_LLM_MODEL=claude-sonnet-4-5
BRH_LLM_TEMPERATURE=0
BRH_LLM_MAX_TOKENS=2048

ANTHROPIC_API_KEY=
# Optional: route Claude through a proxy / gateway (Azure, LiteLLM, ...).
ANTHROPIC_BASE_URL=

OPENAI_API_KEY=
# Optional: route OpenAI-compatible traffic through a gateway.
OPENAI_BASE_URL=

# --- Embeddings (configurable; see ADR-0004) --------------------------
# EMBEDDING_PROVIDER selects how chunk text becomes vectors:
#   pinecone -> Pinecone integrated inference embeds server-side (no key beyond Pinecone)
#   openai   -> client-side embeddings via the OpenAI API (or compatible gateway)
#   hashing  -> deterministic offline embeddings, tests/dev only
BRH_EMBEDDING_PROVIDER=pinecone
BRH_EMBEDDING_MODEL=multilingual-e5-large
BRH_EMBEDDING_DIM=1024

# --- Vector store (Pinecone; see ADR-0003) ----------------------------
# The index is provisioned out-of-band. Runtime only connects.
BRH_PINECONE_API_KEY=
BRH_PINECONE_INDEX_NAME=brh-intelligence
BRH_PINECONE_NAMESPACE=default
# Vector backend: pinecone_integrated | pinecone | memory
BRH_VECTOR_BACKEND=pinecone_integrated

# --- Postgres (corpus system of record; see ADR-0003) -----------------
BRH_POSTGRES_ENABLED=true
BRH_POSTGRES_HOST=localhost
BRH_POSTGRES_PORT=5432
BRH_POSTGRES_DB=brh_corpus
BRH_POSTGRES_USER=brh
BRH_POSTGRES_PASSWORD=brh
BRH_POSTGRES_SCHEMA=corpus

# --- Retrieval --------------------------------------------------------
BRH_RETRIEVAL_TOP_K=6
# --- Web inventory (discovery of brh.ht) ------------------------------
BRH_WEB_BASE_URL=https://www.brh.ht
BRH_WEB_USER_AGENT=brh-intelligence-inventory/0.1 (+public-sector document inventory)
BRH_WEB_REQUEST_DELAY=0.3
BRH_WEB_TIMEOUT=30
BRH_WEB_MAX_RETRIES=3

# --- Public PDF serving (citations open the original page) ------------
# Base URL the frontend uses to fetch a source PDF. The web app serves
# PDFs from BRH_RAW_DIR via /api/pdfs/{slug}; deep links append #page=N.
BRH_PUBLIC_PDF_BASE_URL=http://localhost:3000/api/pdfs

# --- Observability (LangSmith; see ADR-0009) --------------------------
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=brh-intelligence

# --- LangGraph Platform / agent server --------------------------------
# Local `langgraph dev` default. Deployed URL is set on the frontend.
BRH_LANGGRAPH_URL=http://localhost:2024
BRH_LANGGRAPH_ASSISTANT_ID=agent

# --- Web app (Vercel) -------------------------------------------------
BRH_CORS_ALLOWED_ORIGINS=http://localhost:3000
