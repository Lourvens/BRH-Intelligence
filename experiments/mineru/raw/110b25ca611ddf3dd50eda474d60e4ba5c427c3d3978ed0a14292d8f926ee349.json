            0.246,
            0.603,
            0.766,
            0.63
          ],
          "content": [
            {
              "type": "text",
              "content": "Prévisions de l’inflation en variation mensuelle et annuelle sur trois mois (décembre 2025, janvier et février 2026)"
            }
          ]
        },
