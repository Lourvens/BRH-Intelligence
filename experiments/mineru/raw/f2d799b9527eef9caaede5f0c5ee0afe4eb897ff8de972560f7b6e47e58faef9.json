            0.09
          ],
          "content": [
            {
              "type": "text",
              "content": "BRH"
            }
          ]
        },
        {
          "type": "header",
          "index": 1,
          "bbox": [
            0.145,
            0.064,
            0.392,
            0.129
          ],
          "content": [
            {
              "type": "text",
              "content": "Banque de la République d'Haiti\nCIRCULAIRE\nNo 95-1A"
            }
          ]
        },
        {
          "type": "doc_title",
          "index": 2,
          "bbox": [
            0.341,
            0.146,
            0.652,
            0.168
          ],
          "content": [
            {
              "type": "text",
              "content": "AUX MAISONS DE TRANSFERT"
            }
          ],
          "level": 1
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.064,
            0.185,
            0.862,
            0.278
          ],
          "content": [
            {
              "type": "text",
              "content": "Conformément au paragraphe premier de l'article 2.1.2 de la loi du 21 février 2001 relative au blanchiment des avoirs provenant du trafic illicite de la drogue et d'autres infractions graves, pour tenir compte de l'évolution du cours de la gourde par rapport aux principales devises étrangères, la Banque de la République d'Haïti (BRH) modifie le seuil établi par la loi ainsi qu'il suit :"
            }
          ]
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.064,
            0.295,
            0.863,
            0.353
          ],
          "content": [
            {
              "type": "text",
              "content": "Les maisons de transfert sont tenus de recueillir de tous clients, réguliers ou occasionnels, des déclarations de transaction en espèces ou au porteur pour tout montant supérieur ou égal à QUARANTE MILLE GOURDES (Gdes 40,000."
            },
            {
              "type": "equation_inline",
              "content": "^{00}"
            },
            {
              "type": "text",
              "content": ") ou son équivalent en monnaies étrangères."
            }
          ]
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.064,
            0.368,
            0.863,
            0.48
          ],
          "content": [
            {
              "type": "text",
              "content": "Les formulaires de déclaration de transaction des clients annexés à la présente circulaire devront être transmis à l'Unité Centrale de Renseignements Financier (UCREF) au plus tard trois (3) jours ouvrables pour les maisons de transfert se trouvant dans la zone métropolitaine et cinq (5) jours ouvrables pour les maisons de transfert se trouvant en provinces, après qu'ils ont été remplis. Les copies desdits formulaires doivent être convenablement répertoriées et disponibles pour inspection par la Banque de la République d'Haïti."
            }
          ]
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.063,
            0.493,
            0.862,
            0.55
          ],
          "content": [
            {
              "type": "text",
              "content": "En cas de non respect de la présente circulaire, les maisons de transfert s'exposent à des pénalités et à des mesures administratives, ce sans préjudice des autres sanctions dont peut être frappée l'institution ou la personne fautive, en vertu de la loi du 21 février 2001."
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 7,
          "bbox": [
            0.064,
            0.565,
            0.675,
            0.585
          ],
          "content": [
            {
              "type": "text",
              "content": "a) Pénalité pour non disponibilité de renseignements pour inspection"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.064,
            0.583,
            0.862,
            0.623
          ],
          "content": [
            {
              "type": "text",
              "content": "A défaut de fournir les copies des formulaires, les maisons de transfert sont assujetties à une pénalité de cinq mille gourdes (Gdes 5, 000."
            },
            {
              "type": "equation_inline",
              "content": "^{00}"
            },
            {
              "type": "text",
              "content": ") par jour d'infraction."
            }
          ]
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.062,
            0.637,
            0.863,
            0.678
          ],
          "content": [
            {
              "type": "text",
              "content": "La période de pénalité s'étend du jour de l'infraction (demande de renseignements par la BRH) jusqu'à celui où les renseignements sont mis à la disposition des agents de la BRH."
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 10,
          "bbox": [
            0.064,
            0.693,
            0.416,
            0.712
          ],
          "content": [
            {
              "type": "text",
              "content": "b) Pénalité pour absence de formulaire"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.063,
            0.712,
            0.863,
            0.752
          ],
          "content": [
            {
              "type": "text",
              "content": "A défaut de remplir le formulaire de transaction, les maisons de transfert encourent une amende de cent mille gourdes (Gdes. 100,000."
            },
            {
              "type": "equation_inline",
              "content": "^{90}"
            },
            {
              "type": "text",
              "content": ") par jour d'infraction."
            }
          ]
        },
        {
          "type": "text",
          "index": 12,
          "bbox": [
            0.062,
            0.767,
            0.864,
            0.807
          ],
          "content": [
            {
              "type": "text",
              "content": "La période de pénalité s'étend du jour où une transaction aurait du faire l'objet d'un report auprès de l'UCREF au jour où la BRH constate l'infraction."
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 13,
          "bbox": [
            0.063,
            0.823,
            0.546,
            0.842
          ],
          "content": [
            {
              "type": "text",
              "content": "c) Pénalité pour retard de transmission de formulaire"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 14,
          "bbox": [
            0.062,
            0.841,
            0.864,
            0.881
          ],
          "content": [
            {
              "type": "text",
              "content": "En cas de retard de transmission d'un formulaire, les maisons de transfert encourent une pénalité de cinq mille gourdes (Gdes. 5,000."
            },
            {
              "type": "equation_inline",
              "content": "^{00}"
            },
            {
              "type": "text",
              "content": ") par jour d'infraction."
            }
          ]
        },
        {
          "type": "footer",
          "index": 15,
          "bbox": [
            0.13,
            0.901,
            0.796,
            0.919
          ],
          "content": [
            {
              "type": "text",
              "content": "P.O. BOX 1570, Port-au-Prince, Haïti. Téléphone: (509) 299-(1200 à 09 ( Fax: (509) 299-1215"
            }
          ]
        }
      ]
    },
    {
      "page_idx": 1,
      "blocks": [
        {
          "type": "text",
          "index": 0,
          "bbox": [
            0.062,
            0.075,
            0.858,
            0.115
          ],
          "content": [
            {
              "type": "text",
              "content": "La période de pénalité s'étend du jour où un formulaire aurait du être transmis à l'UCREF au jour où cette dernière le reçoit."
            }
          ]
        },
        {
          "type": "paragraph_title",
          "index": 1,
          "bbox": [
            0.062,
            0.13,
            0.495,
            0.149
          ],
          "content": [
            {
              "type": "text",
              "content": "d) Pénalité pour non transmission de formulaire"
            }
          ],
          "level": 2
        },
        {
          "type": "text",
          "index": 2,
          "bbox": [
            0.061,
            0.149,
            0.859,
            0.206
          ],
          "content": [
            {
              "type": "text",
              "content": "En cas de non transmission de formulaire de transactions dûment rempli à l'UCREF, les maisons de transfert encourent une pénalité de cent mille gourdes (Gdes. 100,000."
            },
            {
              "type": "equation_inline",
              "content": "^{90}"
            },
            {
              "type": "text",
              "content": ") par jour d 'infraction."
            }
          ]
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.062,
            0.222,
            0.859,
            0.261
          ],
          "content": [
            {
              "type": "text",
              "content": "La période de pénalité s'étend du jour où un formulaire aurait dû être transmis au jour où la BRH constate l'infraction."
            }
          ]
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.062,
            0.294,
            0.86,
            0.334
          ],
          "content": [
            {
              "type": "text",
              "content": "La présente circulaire entre en vigueur le 3 novembre 2008 et remplace la circulaire 95 du 1 "
            },
            {
              "type": "equation_inline",
              "content": "^{ier}"
            },
            {
              "type": "text",
              "content": " aout 2000."
            }
          ]
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.063,
            0.368,
            0.35,
            0.388
          ],
          "content": [
            {
              "type": "text",
              "content": "Port-au-Prince, le 30 octobre 2008"
            }
          ]
        },
