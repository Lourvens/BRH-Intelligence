          "bbox": [
            0.037,
            0.128,
            0.798,
            0.148
          ],
          "content": [
            {
              "type": "text",
              "content": "La circulaire 95-1A de la BRH exige que les maisons de transfert recueillent les informations sur la transaction."
            }
          ],
          "level": 2
        },
