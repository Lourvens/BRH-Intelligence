          ],
          "content": [
            {
              "type": "text",
              "content": "Variation mensuelle",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " : Variation par rapport au mois précédent."
            }
          ]
        },
        {
          "type": "text",
          "index": 2,
          "bbox": [
            0.112,
            0.168,
            0.756,
            0.188
          ],
          "content": [
            {
              "type": "text",
              "content": "Glissement annuel",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " : Variation par rapport au même mois de l’année antérieure."
            }
          ]
        },
        {
          "type": "text",
          "index": 3,
          "bbox": [
            0.112,
            0.207,
            0.778,
            0.227
          ],
          "content": [
            {
              "type": "text",
              "content": "Inflation",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " : Mouvement persistant à la hausse du niveau général des prix."
            }
          ]
        },
        {
          "type": "text",
          "index": 4,
          "bbox": [
            0.112,
            0.245,
            0.619,
            0.265
          ],
          "content": [
            {
              "type": "text",
              "content": "Désinflation",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " : Ralentissement de la croissance des prix."
            }
          ]
        },
        {
          "type": "text",
          "index": 5,
          "bbox": [
            0.113,
            0.284,
            0.811,
            0.322
          ],
          "content": [
            {
              "type": "text",
              "content": "Déflation",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " : Baisse du niveau général des prix associée à une contraction de la masse monétaire et du crédit."
            }
          ]
        },
        {
          "type": "text",
          "index": 6,
          "bbox": [
            0.113,
            0.341,
            0.824,
            0.4
          ],
          "content": [
            {
              "type": "text",
              "content": "Inflation sous-jacente",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " : Tendance de long terme des prix, tout en excluant la volatilité, les mouvements saisonniers, conjoncturels, et les chocs qui affectent les composantes du panier considéré."
            }
          ]
        },
        {
          "type": "text",
          "index": 7,
          "bbox": [
            0.113,
            0.419,
            0.789,
            0.439
          ],
          "content": [
            {
              "type": "text",
              "content": "Région Nord",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " : Elle couvre les départements du Nord, Nord-Est et Nord-Ouest."
            }
          ]
        },
        {
          "type": "text",
          "index": 8,
          "bbox": [
            0.113,
            0.457,
            0.856,
            0.478
          ],
          "content": [
            {
              "type": "text",
              "content": "Région Sud",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " : Elle comprend les départements du Sud de la Grand-Anse et des Nippes."
            }
          ]
        },
        {
          "type": "text",
          "index": 9,
          "bbox": [
            0.113,
            0.496,
            0.849,
            0.534
          ],
          "content": [
            {
              "type": "text",
              "content": "Région Reste Ouest",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " : Y sont inclus les départements du Sud-Est et de l’Ouest à l’exception de l’aire métropolitaine"
            }
          ]
        },
        {
          "type": "text",
          "index": 10,
          "bbox": [
            0.113,
            0.553,
            0.761,
            0.573
          ],
          "content": [
            {
              "type": "text",
              "content": "Région Transversale",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " : Elle regroupe les départements du Centre et de l’Artibonite."
            }
          ]
        },
        {
          "type": "text",
          "index": 11,
          "bbox": [
            0.112,
            0.593,
            0.855,
            0.631
          ],
          "content": [
            {
              "type": "text",
              "content": "Aire Métropolitaine",
              "styles": [
                "bold"
              ]
            },
            {
              "type": "text",
              "content": " : Elle contient les villes de Port-au-Prince, de Delmas, de Pétion-Ville, de Carrefour et de Croix des Bouquets."
            }
          ]
        },
