{
  "name": "video",
  "version": "0.1.0",
  "private": true,
  "description": "BRH Intelligence — 30 s presentation clip, rendered with Remotion.",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts BrhPresentation out/brh-presentation.mp4",
    "still": "remotion still src/index.ts BrhPresentation out/frame.png --frame=520",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.300",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remotion": "^4.0.300"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "typescript": "^5.9.0"
  }
}
