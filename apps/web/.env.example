# Backend LangGraph server. Local `langgraph dev` by default; set the
# deployed LangGraph Platform URL in production.
NEXT_PUBLIC_LANGGRAPH_URL=http://localhost:2024
NEXT_PUBLIC_LANGGRAPH_ASSISTANT_ID=agent

# Optional hybrid visual routing. When true, the assistant shell may delegate
# chart/graph blocks to a CopilotKit + Open Generative UI surface. The native
# BRH renderer remains the fallback.
# NEXT_PUBLIC_OPEN_INTELLIGENT_UI=false

# Repo data directory (contains processed/catalog.json and the source PDFs).
# Defaults to ../../data relative to apps/web when unset.
# BRH_DATA_DIR=/absolute/path/to/brh-intelligence/data
